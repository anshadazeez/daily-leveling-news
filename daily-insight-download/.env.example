# Keep API keys on a backend/proxy server. Do not expose them in client-side Vite variables.
ARXIV_BASE_URL=https://export.arxiv.org/api/query
NEWSAPI_BASE_URL=https://newsapi.org/v2
NEWSAPI_KEY=replace_on_server_only
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
ALPHA_VANTAGE_API_KEY=replace_on_server_only

# Use a long random value if you later add server-side sessions.
SESSION_SECRET=replace_with_32_plus_random_bytes
